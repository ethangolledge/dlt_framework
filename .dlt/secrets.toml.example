# Copy to .dlt/secrets.toml (git-ignored) for local runs. dlt reads it automatically from the
# repo root, so nothing needs exporting. Production uses environment variables instead.

# Where run monitoring goes for this environment: a folder/bucket (Parquet) or a database URL.
[monitoring]
uri = "file://test_data/monitoring"

[destination.duckdb]
credentials = "test_data/warehouse.duckdb"

# [destination.postgres]
# credentials = "postgresql://user:password@localhost:5432/database"

# Source credentials live under sources.<source name>, e.g. for SqlSource(name="erp"):
# [sources.erp]
# credentials = "mssql+pyodbc://reader:password@host/erp?driver=ODBC+Driver+18+for+SQL+Server"
