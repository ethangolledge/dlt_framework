DESTINATION=duckdb

# Stable identities are required in production.
DLT_FRAMEWORK_ENV=production
PIPELINE_NAME=client_source
DATASET_NAME=raw_client_source

# Keep the DuckDB filename different from DATASET_NAME.
DESTINATION__DUCKDB__CREDENTIALS=/data/client.duckdb
# DESTINATION__POSTGRES__CREDENTIALS=postgresql://user:password@host:5432/database

PIPELINE_RETRY_ATTEMPTS=5
PIPELINE_RETRY_MIN_WAIT=4
PIPELINE_RETRY_MAX_WAIT=60
MAX_BACKFILL_CHUNKS=10000
LOG_FORMAT=json
LOG_LEVEL=INFO

# dlt working directory. Persisting this directory preserves pending load packages and traces.
DLT_DATA_DIR=/var/lib/dlt
# Committed pipeline state is restored from the destination on a clean runner.
PIPELINES__RESTORE_FROM_DESTINATION=true
