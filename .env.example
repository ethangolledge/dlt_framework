# Destination credentials (dlt native variables). Keep the DuckDB file name different from
# every pipeline's dataset name.
DESTINATION__DUCKDB__CREDENTIALS=/data/warehouse.duckdb
# DESTINATION__POSTGRES__CREDENTIALS=postgresql://user:password@host:5432/database

# Source credentials resolve from sources.<source name>.credentials, e.g. for SqlSource(name="erp"):
# SOURCES__ERP__CREDENTIALS=mssql+pyodbc://reader:password@host/erp?driver=ODBC+Driver+18+for+SQL+Server
# FilesystemSource buckets use dlt's filesystem credentials:
# SOURCES__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=...
# SOURCES__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=...

LOG_FORMAT=json
LOG_LEVEL=INFO

# dlt working directory. Persist it to keep pending load packages across restarts.
DLT_DATA_DIR=/var/lib/dlt
# Restore committed state from the destination on a clean runner.
PIPELINES__RESTORE_FROM_DESTINATION=true
